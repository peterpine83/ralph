{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    // Override for React/browser environment
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": [],
    "jsx": "react-jsx",

    // Dashboard uses bundler module resolution
    "target": "ES2020",
    "useDefineForClassFields": true,

    // Relax verbatimModuleSyntax for React patterns
    "verbatimModuleSyntax": false
  },
  "include": ["src"]
}
