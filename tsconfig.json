{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    // Target & Module (Bun-optimized)
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["bun-types"],

    // Module behavior
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,

    // No emit (Bun runs TS directly)
    "noEmit": true,
    "skipLibCheck": true,

    // === STRICT MODE (Essential for AI coding) ===
    // Catches errors at compile time, not runtime
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "useUnknownInCatchVariables": true,
    "alwaysStrict": true,

    // === EXTRA STRICT (Wiggum loop optimization) ===
    // Clear, actionable errors help AI fix issues faster
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    // noPropertyAccessFromIndexSignature disabled - too strict for process.env patterns
    // "noPropertyAccessFromIndexSignature": true,
    // exactOptionalPropertyTypes disabled - causes friction with `prop?: T` vs `prop: T | undefined`
    // "exactOptionalPropertyTypes": true,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,
    "noUncheckedSideEffectImports": true,

    // Consistency
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "*.ts",
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dashboard"
  ]
}
