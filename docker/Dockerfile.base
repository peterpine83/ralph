# Use Node.js slim as base for Claude CLI compatibility
# Note: Original plan used Bun, but Claude CLI requires Node.js runtime
FROM node:22-slim

# Install required packages:
# - iptables: for firewall support (network isolation)
# - ipset: for managing IP sets in firewall rules
# - curl: for fetching GitHub IP ranges and verification
# - dnsutils: for dig command to resolve domain names
# - jq: for parsing JSON responses
# - iproute2: for ip command to get host network info
# - aggregate: for CIDR aggregation (GitHub IP ranges)
# - git: for Ralph's git operations within container
# - sudo: for running firewall as root, then dropping to non-root user
# - gosu: for proper privilege dropping
RUN apt-get update && apt-get install -y --no-install-recommends \
    iptables \
    ipset \
    curl \
    dnsutils \
    jq \
    iproute2 \
    aggregate \
    git \
    ca-certificates \
    sudo \
    gosu \
    openssh-client \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Install GitHub CLI
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | tee /etc/apt/sources.list.d/github-cli.list > /dev/null \
    && apt-get update \
    && apt-get install -y gh \
    && rm -rf /var/lib/apt/lists/*

# Note: We don't force SSH for GitHub URLs. gh CLI can handle HTTPS auth via credential helper.
# If SSH keys are provided, users can configure git to use them.
# RUN git config --global url."git@github.com:".insteadOf "https://github.com/"

# Install Bun runtime (for projects that use bun as package manager)
# Copy binaries to /usr/local/bin instead of symlinking from /root/.bun
# because the container runs as non-root 'node' user who can't access /root/
RUN curl -fsSL https://bun.sh/install | bash && \
    cp /root/.bun/bin/bun /usr/local/bin/bun && \
    cp /root/.bun/bin/bunx /usr/local/bin/bunx && \
    chmod +x /usr/local/bin/bun /usr/local/bin/bunx

# Install Claude CLI via native installer (recommended by Anthropic)
# Copy binary to /usr/local/bin instead of symlinking from /root/.local/bin
# because the container runs as non-root 'node' user who can't access /root/
RUN curl -fsSL https://claude.ai/install.sh | bash && \
    cp /root/.local/bin/claude /usr/local/bin/claude && \
    chmod +x /usr/local/bin/claude

# Firewall script from Anthropic devcontainer (network isolation)
COPY init-firewall.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/init-firewall.sh

# Create non-root user for Claude CLI (--dangerously-skip-permissions requires non-root)
# Node image already has node:node (1000:1000), so we use that user
# Just ensure .claude directory exists with proper permissions
RUN mkdir -p /home/node/.claude && \
    chown -R node:node /home/node

# Create entrypoint script that runs firewall as root, then drops to ralph user
COPY entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/entrypoint.sh

# Create workspace directory with proper permissions
WORKDIR /workspace

# Default command (overridden by orchestrator)
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["claude", "--version"]
